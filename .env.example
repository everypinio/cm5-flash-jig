# Raspberry Pi hardware test settings.
# Copy this file to .env on the Raspberry Pi and adjust values for your stand.

# Allows pytest to toggle DUT power. Keep disabled until the hardware profile
# and safe-off behaviour have been checked on the stand.
CM_FLASHER_ENABLE_POWER_WRITE=0

# Rev.2 onboard DUT power switch and INA229 monitor.
DUT_POWER_BACKEND=onboard_ina229
DUT_POWER_NOMINAL_V=5.0
DUT_POWER_CURRENT_LIMIT_A=3.0
DUT_POWER_MIN_V=4.75
DUT_POWER_MAX_V=5.25
DUT_POWER_OFF_MAX_V=0.5
DUT_POWER_IDLE_CURRENT_MAX_A=0.1
DUT_POWER_ENABLE_GPIO=20
DUT_POWER_ALERT_GPIO=21
DUT_POWER_SETTLE_S=1.0

INA229_SPI_BUS=0
INA229_SPI_DEVICE=1
INA229_SPI_MAX_HZ=1000000
INA229_SHUNT_OHMS=0.01
INA229_ADC_RANGE=0
INA229_CONVERSION_TIME_CODE=3
MOCK_INA229=0

# Legacy PwrBlock compatibility. Set DUT_POWER_BACKEND=pwrblock on rev.1.
PWRBLOCK_CHANNEL=0
PWRBLOCK_TEST_VOLTAGE=5.0
PWRBLOCK_TEST_CURRENT=3.0
PWRBLOCK_TEST_MIN_VOLTAGE=4.75
PWRBLOCK_TEST_MAX_VOLTAGE=5.25
PWRBLOCK_DUT_VOLTAGE=5.0
PWRBLOCK_DUT_CURRENT=3.0
PWRBLOCK_DUT_MIN_VOLTAGE=4.75
PWRBLOCK_DUT_MAX_VOLTAGE=5.25

# ADS1015 power-rail measurements. Set MOCK_ADC=1 only for dry lab runs
# without ADC hardware.
MOCK_ADC=0
ADC_MODEL=ADS1015
ADC_I2C_BUS=1
ADC_I2C_ADDRESS=0x48
ADC_FULL_SCALE_V=4.096
ADC_5V_ENABLED=1
ADC_5V_CHANNEL=2
ADC_5V_SCALE=2.0
ADC_5V_MIN=4.75
ADC_5V_MAX=5.25
ADC_3V3_CHANNEL=0
ADC_3V3_SCALE=1.0
ADC_3V3_MIN=3.135
ADC_3V3_MAX=3.465
ADC_1V8_CHANNEL=1
ADC_1V8_SCALE=1.0
ADC_1V8_MIN=1.71
ADC_1V8_MAX=1.89

# Optional explicit VISA resource or Linux USBTMC device.
# PWRBLOCK_RESOURCE=/dev/usbtmc0

# Use the real rpiboot/flashing backend on a production stand.
MOCK_FLASHING=0

# DUT boot log UART on the CM5 flash jig host.
CM_FLASHER_UART_DEVICE=/dev/ttyAMA0
CM_FLASHER_UART_BAUD=115200

# Image and optional fallback target disk. Normally leave CM_FLASHER_DEVICE
# unset so the disk newly detected after rpiboot is used.
CM_FLASHER_IMAGE=/home/raspberrypi/images/cm5-test.img.xz
# CM_FLASHER_DEVICE=/dev/sda

# Keep real eMMC writes opt-in. Set to 1 only on a commissioned stand.
CM_FLASHER_ENABLE_FLASH_WRITE=0


# Standcloud integration
# Set the real production key only in the deployed .env; never commit it.
HARDPY_SC_API_KEY=

# HardPy metadata for the main test plan.
HARDPY_USER_NAME=User
HARDPY_DUT_NAME=Raspberry pi CM5
HARDPY_DUT_TYPE=Module
HARDPY_STAND_NAME=CM5 flasher
HARDPY_STAND_LOCATION=ESPOO

# HardPy metadata for the power-on test plan.
# These override the metadata used by the main test plan only.
POWER_ON_HARDPY_USER_NAME=User
POWER_ON_HARDPY_DUT_NAME=CM5 flasher 
POWER_ON_HARDPY_DUT_TYPE=Test jig
POWER_ON_HARDPY_STAND_NAME=CM5 flasher
# Identity fields for the flasher self-test report. Leave the serial number
# empty to use the Raspberry Pi machine ID automatically.
POWER_ON_HARDPY_DUT_PART_NUMBER=CM5-FLASHER
POWER_ON_HARDPY_DUT_SERIAL_NUMBER=
POWER_ON_HARDPY_BATCH_SERIAL_NUMBER=POWER-ON-SELFTEST
