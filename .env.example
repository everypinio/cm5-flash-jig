# Raspberry Pi hardware test settings.
# Copy this file to .env on the Raspberry Pi and adjust values for your stand.

# Allows pytest to toggle the PwrBlock output in test_04.
CM_FLASHER_ENABLE_POWER_WRITE=0

# PwrBlock voltage/current settings for the power smoke test.
PWRBLOCK_CHANNEL=0
PWRBLOCK_TEST_VOLTAGE=5.0
PWRBLOCK_TEST_CURRENT=3.0
PWRBLOCK_TEST_MIN_VOLTAGE=4.75
PWRBLOCK_TEST_MAX_VOLTAGE=5.25
PWRBLOCK_DUT_VOLTAGE=5.0
PWRBLOCK_DUT_CURRENT=3.0
PWRBLOCK_DUT_MIN_VOLTAGE=4.75
PWRBLOCK_DUT_MAX_VOLTAGE=5.25
DUT_POWER_SETTLE_S=1.0

# ADS1015 power-rail measurements. Set MOCK_ADC=1 only for dry lab runs
# without ADC hardware.
MOCK_ADC=0
ADC_MODEL=ADS1015
ADC_I2C_BUS=1
ADC_I2C_ADDRESS=0x48
ADC_FULL_SCALE_V=4.096
ADC_5V_ENABLED=1
ADC_5V_CHANNEL=2
ADC_5V_SCALE=2.0
ADC_5V_MIN=4.75
ADC_5V_MAX=5.25
ADC_3V3_CHANNEL=0
ADC_3V3_SCALE=1.0
ADC_3V3_MIN=3.135
ADC_3V3_MAX=3.465
ADC_1V8_CHANNEL=1
ADC_1V8_SCALE=1.0
ADC_1V8_MIN=1.71
ADC_1V8_MAX=1.89

# Optional explicit VISA resource or Linux USBTMC device.
# PWRBLOCK_RESOURCE=/dev/usbtmc0

# Image and target disk used by flash dry-run tests.
CM_FLASHER_IMAGE=/home/raspberrypi/images/cm5-test.img.xz
# CM_FLASHER_DEVICE=/dev/sda

# Keep real eMMC writes opt-in. Prefer setting this only for one command:
# CM_FLASHER_ENABLE_FLASH_WRITE=1


# Standcloud integration
HARDPY_SC_API_KEY=your_api_key_here

# HardPy metadata for the main test plan.
HARDPY_USER_NAME=User
HARDPY_DUT_NAME=Raspberry pi CM5
HARDPY_DUT_TYPE=Module
HARDPY_STAND_NAME=CM5 flasher
HARDPY_STAND_LOCATION=ESPOO

# HardPy metadata for the power-on test plan.
# These override the metadata used by the main test plan only.
POWER_ON_HARDPY_USER_NAME=User
POWER_ON_HARDPY_DUT_NAME=CM5 flasher 
POWER_ON_HARDPY_DUT_TYPE=Test jig
POWER_ON_HARDPY_STAND_NAME=CM5 flasher
# Identity fields for the flasher self-test report. Leave the serial number
# empty to use the Raspberry Pi machine ID automatically.
POWER_ON_HARDPY_DUT_PART_NUMBER=CM5-FLASHER
POWER_ON_HARDPY_DUT_SERIAL_NUMBER=
POWER_ON_HARDPY_BATCH_SERIAL_NUMBER=POWER-ON-SELFTEST
